# ============================================================
# local.env — TEMPLATE de variáveis de ambiente (SEM segredos).
# Copie para um .env local e preencha os valores reais. Este arquivo
# é versionado como exemplo; os .env com valores reais estão no
# .gitignore. O Docker lê infra/.env (rode o compose de dentro de infra/).
# ============================================================

# <---------- Airflow ---------->

AIRFLOW_IMAGE_NAME=<preencher>
AIRFLOW__CORE__FERNET_KEY=<gerar-com-python-cryptography-fernet>
AIRFLOW_HOME=<preencher>
AIRFLOW_USERNAME=<preencher>
AIRFLOW_PASSWORD=<definir-senha>
AIRFLOW_UID=<preencher>


# <---------- Postgres Airflow ---------->

POSTGRES_USER=<preencher>
POSTGRES_PASSWORD=<definir-senha>
POSTGRES_DB=<preencher>
# Porta publicada no host. Mude se outro stack local já ocupa a 5432 — o
# Airflow usa a mesma para achar o banco de metadados (network_mode: host).
POSTGRES_PORT=5432


# <---------- Postgres Data Warehouse ---------->
POSTGRES_USER_DW=<preencher>
POSTGRES_PASSWORD_DW=<definir-senha>
POSTGRES_DB_DW=<preencher>


# <---------- MinIO ---------->
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=<definir-access-key>
MINIO_SECRET_KEY=<definir-secret>
MINIO_BUCKET=<preencher>
MINIO_REGION=us-east-1
MINIO_URL_STYLE=path
MINIO_USE_SSL=false


# <---------- Trino (ingestão SALIC v2) ---------->
# ATENÇÃO: estas variáveis precisam estar em **infra/.env**, não no .env da
# raiz. O compose interpola ${VAR} a partir do .env do diretório do arquivo
# compose, e a diretiva `environment:` do serviço trino vence o `env_file` —
# um valor posto só na raiz seria sobrescrito por vazio, sem aviso.
# O Trino, por sua vez, lê o ambiente do container via ${ENV:...} nos arquivos
# de infra/trino/etc/catalog/. Nenhum valor real entra em arquivo versionado.

TRINO_VERSION=478
TRINO_PORT=8090
# Heap da JVM = 80% deste limite. Terabyte não exige heap grande (a cópia é
# streaming, não agregação); subir isso ajuda mais quando há muitas fatias em
# paralelo do que quando a tabela é grande.
TRINO_MEM_LIMIT=6g

# Destino (Postgres do data warehouse). Do container do Trino, o Postgres do
# compose responde por `postgres` — não por localhost.
TRINO_DW_HOST=postgres
TRINO_DW_PORT=5432
TRINO_DW_DB=<preencher>
TRINO_DW_USER=<preencher>
TRINO_DW_PASSWORD=<definir-senha>

# Origem (SQL Server do SALIC).
#
# NUNCA preencha aqui. Este arquivo é VERSIONADO num repositório PÚBLICO — um
# valor real neste bloco vaza host, usuário e senha do SALIC, e continua no
# histórico do git mesmo depois de removido. Os valores reais vão em
# infra/.env, que está no .gitignore.
#
# Um único host serve os cinco bancos
# (SAC, Agentes, Tabelas, ControleDeAcesso, BDCorporativo). Se algum banco
# estiver em outro servidor, edite só o .properties daquele catálogo.
SALIC_MSSQL_HOST=<preencher>
SALIC_MSSQL_PORT=1433
SALIC_MSSQL_USER=<preencher>
SALIC_MSSQL_PASSWORD=<definir-senha>
SALIC_MSSQL_URL_OPTS=encrypt=false;trustServerCertificate=true;loginTimeout=30
# Dominio de busca da VPN. O container do Trino roda em rede bridge e nao
# herda o resolvedor do host, entao sem isto um nome curto de servidor nao
# resolve. Alternativa: usar o FQDN completo em SALIC_MSSQL_HOST.
SALIC_DNS_SEARCH=<preencher>
